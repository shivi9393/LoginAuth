# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# In development, anything left blank uses a safe local fallback.
# ------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=8080

# CORS — comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Database
# Leave ATLAS_URI blank in development to use an automatic in-memory MongoDB.
# In production this is REQUIRED.
ATLAS_URI=

# Auth — JWT_SECRET is REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRY=1d
JWT_ISSUER=loginauth-api
JWT_AUDIENCE=loginauth-client
BCRYPT_ROUNDS=12

# OTP / password recovery
OTP_TTL_MINUTES=10
RESET_WINDOW_MINUTES=10

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128

# Mail (SMTP) — REQUIRED in production
EMAIL=
PASSWORD=
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_FROM=no-reply@loginauth.local
